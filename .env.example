# Generate a unique password. Use URL-safe characters for DATABASE_URL interpolation.
POSTGRES_PASSWORD=
# Set true when deploying behind HTTPS.
COOKIE_SECURE=false
# Email is opt-in. Configure only an authorized recipient; local app requires exported vars.
EMAIL_ENABLED=false
EMAIL_USER_ID=
EMAIL_RECIPIENT=
# UTC/offset timestamp; excludes historical notices before enablement.
EMAIL_START_AT=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Admin-only source alerts; uses the same explicitly authorized SMTP recipient.
SOURCE_ALERT_EMAIL_ENABLED=false

# 仅将已下载且带SHA256的来源附件复制到指定管理员私有审核队列
SOURCE_DOCUMENTS_ENABLED=false
SOURCE_DOCUMENTS_USER_ID=0
