# Generate a unique password. Use URL-safe characters for DATABASE_URL interpolation.
POSTGRES_PASSWORD=
# Set true when deploying behind HTTPS.
COOKIE_SECURE=false
# Email is opt-in. Configure only an authorized recipient; local app requires exported vars.
EMAIL_ENABLED=false
EMAIL_USER_ID=
EMAIL_RECIPIENT=
# UTC/offset timestamp; excludes historical notices before enablement.
EMAIL_START_AT=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
